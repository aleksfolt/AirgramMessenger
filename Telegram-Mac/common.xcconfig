SIMPLE_SLASH=/

WEBRTC_MAC = 1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) WEBRTC_MAC=$(WEBRTC_MAC)

APP_DISPLAY_NAME = AirGram
AIRGRAM_API_ID =
AIRGRAM_API_HASH =
#include? "AirGram.secrets.xcconfig"
